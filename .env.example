# Copy this file to ".env" and fill in a key.

# Free AI for reading websites: get a key at https://console.groq.com
GROQ_API_KEY=

# Optional: Claude (paid) instead. Only used when GROQ_API_KEY is empty.
# ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_MAX_CHARS=18000                 # most page text sent to the AI per website; lower it if Groq says "too large"
# PORTAL_URL=http://copypaste.onlineurls.com/
# PORT=3000
# MAX_PAGES=5
# PARKED_STATUS=Not Working          # status for parked / for-sale domains
# REDIRECT_AS_STATUS=false           # true: sites that redirect to another domain become "Redirect Site"
# STRIP_PHONE_PUNCTUATION=false      # true: phone numbers keep only + and digits
# USE_SYSTEM_CHROME=true             # false: use Playwright's own Chromium
